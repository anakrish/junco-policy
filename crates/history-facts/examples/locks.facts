language junco.facts.v1;
package examples.locks;
schema lock;

predicate foreign_edit(e: event, p: principal, r: resource) if {
    e.resource == r;
    e.action == action.edit;
    e.principal != p;
}
predicate owner_change(e: event, r: resource) if {
    e.resource == r;
    e.action == action.edit or e.action == action.release or e.action == action.remove;
}
history foreign_owner(p: principal, r: resource) if {
    since e in history { foreign_edit(e, p, r); } unless { owner_change(e, r); };
}
predicate refresh_or_reset(e: event, p: principal, r: resource) if {
    e.resource == r;
    e.action == action.edit or e.action == action.remove
        or (e.action == action.read and e.principal == p);
}
history stale_view(p: principal, r: resource) if {
    since e in history { foreign_edit(e, p, r); } unless { refresh_or_reset(e, p, r); };
}
predicate foreign_read(e: event, p: principal, r: resource) if {
    e.resource == r;
    e.action == action.read;
    e.principal != p;
}
predicate reader_change(e: event, r: resource) if {
    e.resource == r;
    e.action == action.read or e.action == action.remove;
}
history foreign_reader(p: principal, r: resource) if {
    since e in history { foreign_read(e, p, r); } unless { reader_change(e, r); };
}
policy locks ordered {
    forbid owner_edit on {principal: p, action: action.edit, resource: r}
        if { foreign_owner(p, r); } report lock.owner;
    forbid owner_release on {principal: p, action: action.release, resource: r}
        if { foreign_owner(p, r); } report lock.owner;
    forbid owner_remove on {principal: p, action: action.remove, resource: r}
        if { foreign_owner(p, r); } report lock.owner;
    forbid stale_edit on {principal: p, action: action.edit, resource: r}
        if { stale_view(p, r); } report lock.stale;
    forbid stale_remove on {principal: p, action: action.remove, resource: r}
        if { stale_view(p, r); } report lock.stale;
    forbid reader_edit on {principal: p, action: action.edit, resource: r}
        if { foreign_reader(p, r); } report lock.reader;
    forbid reader_remove on {principal: p, action: action.remove, resource: r}
        if { foreign_reader(p, r); } report lock.reader;
}
